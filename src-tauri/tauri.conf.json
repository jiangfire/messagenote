{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MessageNote",
  "version": "1.4.0",
  "identifier": "com.messagenote.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MessageNote",
        "width": 1120,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "center": true
      },
      {
        "label": "capture",
        "title": "快速记录",
        "url": "capture.html",
        "width": 680,
        "height": 108,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "center": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1421 http://localhost:1420; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MessageNote",
    "category": "Productivity",
    "shortDescription": "聊天框式本地优先笔记",
    "longDescription": "零摩擦捕获、事后整理的个人笔记应用。全局快捷键唤起捕获浮层，内容落到时间线，按频道归档、按标签横切。支持自建服务端的多设备同步。",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEREUwMzdDMUU2OUFENzUKUldSMXJXa2VmQVBlcmZ5OHNVZkNTSENpczd6OXh4QUdRMkNFWnZ6eXZCWmZPYWpNZ2c3VWZhelcK",
      "endpoints": [
        "https://github.com/jiangfire/messagenote/releases/latest/download/latest.json"
      ]
    }
  }
}
