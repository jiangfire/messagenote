# Docker Compose 用的环境变量。
#
#   cp deploy/.env.example deploy/.env
#   docker compose --env-file deploy/.env up -d

# 同步服务端的唯一凭据。**必须至少 32 个字符**，服务端启动时会强制检查。
# 生成一个：
#   openssl rand -base64 48
MESSAGENOTE_TOKEN=

# 对外暴露的端口。默认 8080。
# MESSAGENOTE_PORT=8080

# ---------------------------------------------------------------- 附件落点（可选）
#
# 不填 = 和笔记放同一个 .sqlite（默认，最简单）。
# 填了 bucket = 附件只落在对象存储，服务器上不存这些字节。
#
# **填了 bucket 就要把其余变量一起填上** —— 只填 bucket 的话 S3 连不上，
# 启动时会被"强制失败"（宁可起不来，也不要让人以为附件在安全的地方）。
# 留空 = SQLite 模式，行为和以前一样。
#
# 兼容 MinIO / R2 / B2：把 endpoint 设成它们给的地址，region 用发行方说明里那个。
# AWS 建议不用 endpoint 和密钥，留空则走 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY。
#
# 桶的权限：读对象要 s3:GetObject、写要 s3:PutObject；
# 还要能列桶（s3:ListBucket）—— 服务端探测「有哪些附件缺失」时用的是 HEAD，
# 没有列权限时 S3 会把「对象不存在」报成 403 而不是 404。
#
# 完整的前后端取舍见 messagenote.env.example 和 README。

# MESSAGENOTE_S3_BUCKET=my-messagenote
# MESSAGENOTE_S3_ENDPOINT=https://s3.example.com
# MESSAGENOTE_S3_REGION=us-east-1
# MESSAGENOTE_S3_ACCESS_KEY_ID=
# MESSAGENOTE_S3_SECRET_ACCESS_KEY=
# 键名前缀，默认 attachments/
# MESSAGENOTE_S3_PREFIX=attachments/
