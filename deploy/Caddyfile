# MessageNote 的 Caddy 配置
#
# 一个域名同时干两件事：
#   1. 托管网页端（静态文件）
#   2. 把 /api/* 反代到只监听环回的服务端
#
# **同源是刻意的。** 服务端自己不带任何 CORS 头；把网页端放在别的域名下，
# 浏览器会直接拦掉所有 /api 请求。同源部署就从根上不需要 CORS ——
# 也就不存在"允许的来源配错了"这种一闪而过的错。
#
# 服务端自己**只说 HTTP 明文**、且默认只绑 127.0.0.1。
# TLS 全部由 Caddy 终结 —— 证书申请、续期、HTTP/2 都不用自己写。
#
# 部署：
#   cargo build --release -p messagenote-server
#   pnpm build
#   # 只拷网页端需要的那三样。**不要**把 dist/index.html 拷过来 ——
#   # 那是 Tauri 主窗口的壳，依赖 window.__TAURI__，在浏览器里只会白屏。
#   #
#   # sw.js **必须**一起拷：Service Worker 只能从根路径 /sw.js 加载，
#   # 而下面 handle 的兜底会把 /sw.js 重写成 web.html（200 + text/html），
#   # 浏览器以 MIME 不符为由拒绝注册 —— 离线壳在所有按文档部署的环境里
#   # **静默失效**，不报任何错。
#   install -d /var/lib/messagenote/web
#   cp -r dist/assets dist/web.html dist/sw.js /var/lib/messagenote/web/
#
# 把 notes.example.com 换成你自己的域名，然后：
#   caddy reload --config /etc/caddy/Caddyfile

notes.example.com {
	# 笔记正文是文本，压缩收益很高
	encode zstd gzip

	root * /var/lib/messagenote/web

	# API 走服务端
	handle /api/* {
		reverse_proxy 127.0.0.1:8787 {
			# **必须关掉响应缓冲，否则实时推送整个不工作。**
			#
			# `/api/events` 是一条永不结束的 SSE 流。反代默认会把响应攒在
			# 缓冲区里再往下发，而一条永远不结束的响应意味着**永远攒不满** ——
			# 表现是浏览器那边连接建好了、却一条事件都收不到，
			# 而且两端都不报错（服务端认为写成功了，客户端认为在等）。
			#
			# 这个坑我在端到端测试的同源代理里先踩到了一次：
			# 那里用 `await upstream.arrayBuffer()` 把整条流缓冲下来，
			# SSE 就再也没通过过。见 scripts/web-e2e/serve.mjs。
			flush_interval -1
		}
	}

	# 打包产物
	handle /assets/* {
		file_server
	}

	# Service Worker 自己。
	#
	# **必须放在兜底 rewrite 之前**，而且要用 `file_server` 真的把它发出去。
	# 少了这一段，`GET /sw.js` 会掉进下面的 `rewrite * /web.html` ——
	# 返回 200 + text/html，浏览器以 MIME 不符为由拒绝注册，报的是
	# "unsupported MIME type ('text/html')"，看起来和 SW 八竿子打不着。
	#
	# 结果是**离线壳在所有按这份文档部署的环境里静默失效**：地铁里点开网页端
	# 直接是浏览器的错误页。这个坑在端到端测试的同源代理里先踩到过一次
	# （scripts/web-e2e/serve.mjs 有同样的处理和说明），生产配置当时漏了。
	handle /sw.js {
		file_server
	}

	# 其余一律回网页端入口。它是单页应用，路由在客户端。
	handle {
		rewrite * /web.html
		file_server
	}

	header {
		# 这个服务只应该通过 HTTPS 访问，别让浏览器有降级的机会
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# 不要对外暴露服务端软件信息
		-Server
	}

	log {
		output file /var/log/caddy/messagenote.log
	}
}

# ---------------------------------------------------------------- 限流
#
# 这个服务对外的凭据只有长期令牌和短期会话，公网上必然会被扫描和爆破。
# **强烈建议**装上限流插件（官方 Caddy 不带 rate_limit）：
#
#   xcaddy build --with github.com/mholt/caddy-ratelimit
#
# 然后在上面的站点块里加上：
#
#	rate_limit {
#		zone auth {
#			match {
#				path /api/session /api/sync/*
#			}
#			key {remote_host}
#			events 30
#			window 1m
#		}
#	}
#
# 另外，令牌至少 32 个字符（服务端启动时会强制检查），
# 这样即便被无限次尝试也不可能撞出来。
